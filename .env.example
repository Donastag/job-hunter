# ── Database ─────────────────────────────────────────────────────────────────
# Use the existing PostgreSQL 16 on VPS — fill in host, user, pass after VPS prep
DATABASE_URL=postgresql://nexara:CHANGE_ME@localhost:5432/nexara

# ── Auth (Better Auth — email/password) ──────────────────────────────────────
BETTER_AUTH_URL=http://YOUR_VPS_IP:3000
# Job Hunter runs on port 3000 (port 80 is reserved for Coolify's Traefik proxy)
BETTER_AUTH_SECRET=GENERATE_WITH: openssl rand -base64 32

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI ───────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Tailscale ────────────────────────────────────────────────────────────────
# VPS Tailscale IP — run: tailscale ip -4 on VPS after setup
# Command Centre only binds to this IP so it's never publicly reachable
TAILSCALE_IP=100.x.x.x

# ── Cron ─────────────────────────────────────────────────────────────────────
PIPELINE_CRON=*/30 * * * *
