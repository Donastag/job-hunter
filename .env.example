# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://nexara:CHANGE_ME@postgres:5432/nexara

# ── PostgreSQL container creds (docker-compose only) ─────────────────────────
POSTGRES_DB=nexara
POSTGRES_USER=nexara
POSTGRES_PASSWORD=CHANGE_ME

# ── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://YOUR_VPS_IP
NEXTAUTH_SECRET=GENERATE_WITH: openssl rand -base64 32

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI (OpenRouter) ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Tailscale ────────────────────────────────────────────────────────────────
# Set to your VPS Tailscale IP (run: tailscale ip -4)
TAILSCALE_IP=100.x.x.x

# ── Cron ─────────────────────────────────────────────────────────────────────
# How often to run job hunt (default: every 30 mins)
PIPELINE_CRON=*/30 * * * *
