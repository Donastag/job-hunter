<%- include('partials/head', { title }) %>
<%- include('partials/nav', { active }) %>

<div style="display:flex;height:calc(100vh - 56px);overflow:hidden;">

  <!-- Sessions sidebar -->
  <div style="width:280px;flex-shrink:0;border-right:1px solid var(--border);overflow-y:auto;background:var(--surface);">
    <div style="padding:14px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
      <div style="font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--text-3);">SUPPORT CHAT</div>
      <% if (openCount > 0) { %>
        <span style="background:rgba(16,185,129,.15);border:1px solid var(--green-ring);color:var(--green);font-size:9px;font-weight:700;padding:2px 7px;border-radius:4px;"><%= openCount %> OPEN</span>
      <% } %>
    </div>

    <% if (sessions.length === 0) { %>
      <div style="padding:32px 16px;text-align:center;font-size:11px;color:var(--text-3);">No chat sessions yet.</div>
    <% } %>

    <% sessions.forEach(function(s) { %>
      <a href="/chat/<%= s.id %>" style="
        display:block;padding:12px 16px;text-decoration:none;
        border-bottom:1px solid var(--border);
        background:<%= selectedId === s.id ? 'rgba(16,185,129,.06)' : 'transparent' %>;
        border-left:3px solid <%= selectedId === s.id ? 'var(--green)' : 'transparent' %>;
        transition:background 120ms;
      ">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;">
          <div style="font-size:12px;font-weight:600;color:var(--text);"><%= s.visitorName || 'Visitor' %></div>
          <% if (s.status === 'open') { %>
            <span style="width:7px;height:7px;border-radius:50%;background:var(--green);flex-shrink:0;margin-top:3px;"></span>
          <% } else { %>
            <span style="width:7px;height:7px;border-radius:50%;background:var(--text-3);flex-shrink:0;margin-top:3px;"></span>
          <% } %>
        </div>
        <div style="font-size:10px;color:var(--text-3);margin-bottom:5px;"><%= s.appName %></div>
        <% if (s.lastMessage) { %>
          <div style="font-size:11px;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px;">
            <%= s.lastMessage.length > 60 ? s.lastMessage.slice(0,60) + '…' : s.lastMessage %>
          </div>
        <% } %>
        <% if (s.lastAt) { %>
          <div style="font-size:9px;color:var(--text-3);margin-top:4px;">
            <%= new Date(s.lastAt).toLocaleString('en-US', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', hour12:false }) %>
          </div>
        <% } %>
      </a>
    <% }) %>
  </div>

  <!-- Main chat area -->
  <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">

    <% if (!selected) { %>
      <!-- Empty state -->
      <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;">
        <div style="font-size:32px;">💬</div>
        <div style="font-size:13px;font-weight:600;color:var(--text);">Select a conversation</div>
        <div style="font-size:12px;color:var(--text-3);">Choose a chat session from the left to view messages.</div>
        <% if (openCount === 0) { %>
          <div style="font-size:11px;color:var(--text-3);margin-top:8px;">No open sessions. Chat widget is live on your apps.</div>
        <% } %>
      </div>
    <% } else { %>

      <!-- Chat header -->
      <div style="padding:12px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">
        <div>
          <div style="font-size:13px;font-weight:700;color:var(--text);"><%= selected.visitorName || 'Visitor' %></div>
          <div style="font-size:10px;color:var(--text-3);margin-top:2px;">
            <%= selected.appName %>
            <% if (selected.visitorEmail) { %> · <%= selected.visitorEmail %><% } %>
            · started <%= new Date(selected.createdAt).toLocaleString('en-US', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', hour12:false }) %>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
          <% if (selected.status === 'open') { %>
            <span style="font-size:9px;color:var(--green);background:rgba(16,185,129,.12);border:1px solid var(--green-ring);padding:3px 8px;border-radius:4px;font-weight:700;">OPEN</span>
            <form method="POST" action="/chat/<%= selectedId %>/close" style="margin:0;">
              <button type="submit" class="btn btn-ghost" style="font-size:10px;padding:4px 10px;">CLOSE</button>
            </form>
          <% } else { %>
            <span style="font-size:9px;color:var(--text-3);background:rgba(100,116,139,.1);border:1px solid var(--border);padding:3px 8px;border-radius:4px;font-weight:700;">CLOSED</span>
            <form method="POST" action="/chat/<%= selectedId %>/reopen" style="margin:0;">
              <button type="submit" class="btn btn-primary" style="font-size:10px;padding:4px 10px;">REOPEN</button>
            </form>
          <% } %>
        </div>
      </div>

      <!-- Messages -->
      <div id="msg-scroll" style="flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:12px;">
        <% if (messages.length === 0) { %>
          <div style="text-align:center;font-size:11px;color:var(--text-3);margin-top:40px;">No messages yet. Waiting for the visitor to write.</div>
        <% } %>

        <% messages.forEach(function(m) { %>
          <div style="display:flex;justify-content:<%= m.sender === 'agent' ? 'flex-end' : 'flex-start' %>;">
            <div style="max-width:68%;">
              <div style="font-size:9px;color:var(--text-3);margin-bottom:4px;<%= m.sender === 'agent' ? 'text-align:right;' : '' %>">
                <%= m.sender === 'agent' ? 'You (Agent)' : (selected.visitorName || 'Visitor') %>
              </div>
              <div style="
                padding:10px 14px;border-radius:<%= m.sender === 'agent' ? '12px 12px 2px 12px' : '12px 12px 12px 2px' %>;
                background:<%= m.sender === 'agent' ? 'rgba(16,185,129,.15)' : 'rgba(255,255,255,.06)' %>;
                border:1px solid <%= m.sender === 'agent' ? 'var(--green-ring)' : 'var(--border)' %>;
                font-size:13px;color:var(--text);line-height:1.5;white-space:pre-wrap;
              "><%= m.message %></div>
              <div style="font-size:9px;color:var(--text-3);margin-top:3px;<%= m.sender === 'agent' ? 'text-align:right;' : '' %>">
                <%= new Date(m.createdAt).toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', hour12:false }) %>
              </div>
            </div>
          </div>
        <% }) %>
        <div id="msg-bottom"></div>
      </div>

      <!-- Reply box -->
      <% if (selected.status === 'open') { %>
        <div style="padding:14px 20px;border-top:1px solid var(--border);flex-shrink:0;">
          <form method="POST" action="/chat/<%= selectedId %>/reply" style="display:flex;gap:10px;align-items:flex-end;">
            <textarea
              name="message"
              placeholder="Type a reply… (Enter to send)"
              id="reply-input"
              style="
                flex:1;padding:10px 14px;min-height:44px;max-height:140px;resize:vertical;
                background:rgba(17,24,39,.8);border:1px solid var(--border);
                border-radius:8px;color:var(--text);font-size:13px;font-family:inherit;
                outline:none;line-height:1.5;
              "
              rows="1"
            ></textarea>
            <button type="submit" class="btn btn-primary" style="height:44px;padding:0 18px;flex-shrink:0;">
              SEND
            </button>
          </form>
          <div style="font-size:10px;color:var(--text-3);margin-top:6px;">Reply appears instantly to the visitor · Ctrl+Enter to submit</div>
        </div>
      <% } else { %>
        <div style="padding:14px 20px;border-top:1px solid var(--border);text-align:center;">
          <div style="font-size:11px;color:var(--text-3);">Session closed. Reopen to reply.</div>
        </div>
      <% } %>

    <% } %>
  </div>
</div>

<script>
  // Auto-scroll to bottom on load
  var bottom = document.getElementById('msg-bottom')
  if (bottom) bottom.scrollIntoView()

  // Auto-poll for new messages every 4s when a session is open
  <% if (selectedId && selected && selected.status === 'open') { %>
  (function() {
    var lastId = '<%= messages.length > 0 ? messages[messages.length-1].createdAt : "" %>'
    var container = document.getElementById('msg-scroll')
    function poll() {
      var url = '/api/chat-poll?sessionId=<%= selectedId %>' + (lastId ? '&after=' + encodeURIComponent(lastId) : '')
      fetch(url).then(function(r) { return r.json() }).then(function(data) {
        if (data.messages && data.messages.length) {
          lastId = data.messages[data.messages.length-1].createdAt
          window.location.reload()
        }
      }).catch(function() {})
    }
    setInterval(poll, 4000)
  })()
  <% } %>

  // Ctrl+Enter submit
  var replyInput = document.getElementById('reply-input')
  if (replyInput) {
    replyInput.addEventListener('keydown', function(e) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.target.closest('form').submit()
      }
    })
  }
</script>

<%- include('partials/foot') %>
