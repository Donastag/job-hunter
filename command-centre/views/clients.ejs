<%- include('partials/head', { title: 'Clients' }) %>
<%- include('partials/nav') %>

<!-- ── Stats Bar ───────────────────────────────────────────────── -->
<div style="background:var(--surface);border-bottom:1px solid var(--border);" class="flex overflow-x-auto">
  <% [
    { k: 'TOTAL CLIENTS',  v: stats.total,    c: 'var(--text)',  sub: 'in address book' },
    { k: 'WON LEADS',      v: stats.wonLeads, c: 'var(--green)', sub: 'from pipeline' },
    { k: 'PIPELINE VALUE', v: 'KES ' + (stats.totalValue).toLocaleString('en-KE',{minimumFractionDigits:2,maximumFractionDigits:2}), c: 'var(--green)', sub: 'from won leads' },
  ].forEach(s => { %>
  <div class="px-7 py-4 flex-shrink-0" style="border-right:1px solid var(--border);min-width:160px;">
    <div class="mono text-2xl font-bold tracking-tight" style="color:<%= s.c %>"><%= s.v %></div>
    <div class="text-xs mt-0.5 tracking-widest" style="color:var(--text-3);"><%= s.k %></div>
    <div class="text-xs mt-0.5" style="color:var(--text-4);font-size:10px;"><%= s.sub %></div>
  </div>
  <% }) %>
</div>

<!-- ── Controls Bar ───────────────────────────────────────────── -->
<div class="px-6 py-3 flex items-center gap-3" style="background:rgba(9,11,15,.8);border-bottom:1px solid var(--border-2);">
  <span class="text-xs tracking-widest" style="color:var(--text-4);">CLIENTS</span>
  <div class="flex-1"></div>
  <button onclick="openModal()" class="btn btn-primary" style="padding:7px 18px;font-size:12px;font-weight:700;">
    + ADD CLIENT
  </button>
</div>

<!-- ── Two-panel layout ───────────────────────────────────────── -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:0;height:calc(100vh - 160px);overflow:hidden;">

  <!-- Left: Address Book -->
  <div style="border-right:1px solid var(--border);overflow-y:auto;">
    <div class="px-6 py-3" style="border-bottom:1px solid var(--border-2);position:sticky;top:0;background:var(--bg);z-index:5;">
      <span style="font-size:10px;letter-spacing:.12em;color:var(--text-3);font-weight:700;">ADDRESS BOOK</span>
      <span class="mono ml-2" style="font-size:10px;color:var(--text-4);"><%= clients.length %> entries</span>
    </div>

    <% if (clients.length === 0) { %>
    <div class="flex flex-col items-center justify-center py-20 gap-3">
      <div style="color:var(--text-3);font-size:12px;">No clients yet</div>
      <button onclick="openModal()" class="btn btn-ghost" style="font-size:11px;">+ ADD FIRST</button>
    </div>
    <% } %>

    <% clients.forEach(c => { %>
    <div class="cli-row" data-id="<%= c.id %>" style="padding:14px 20px;border-bottom:1px solid var(--border-2);cursor:pointer;transition:background 120ms;"
         onclick="selectClient(this, <%= JSON.stringify(c) %>)">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <div>
          <div style="font-size:13px;font-weight:600;color:var(--text)"><%= c.name %></div>
          <% if (c.company) { %><div style="font-size:11px;color:var(--text-3);margin-top:2px"><%= c.company %></div><% } %>
          <% if (c.email) { %><div style="font-size:10px;color:var(--text-4);margin-top:2px"><%= c.email %></div><% } %>
        </div>
        <span class="pill" style="color:var(--text-3);background:rgba(100,116,139,.08);border-color:var(--border);flex-shrink:0;margin-left:8px;">
          <%= (c.source || 'manual').toUpperCase() %>
        </span>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Right: Won Leads from Pipeline -->
  <div style="overflow-y:auto;">
    <div class="px-6 py-3" style="border-bottom:1px solid var(--border-2);position:sticky;top:0;background:var(--bg);z-index:5;">
      <span style="font-size:10px;letter-spacing:.12em;color:var(--text-3);font-weight:700;">WON FROM PIPELINE</span>
      <span class="mono ml-2" style="font-size:10px;color:var(--text-4);"><%= wonLeads.length %> leads</span>
    </div>

    <% if (wonLeads.length === 0) { %>
    <div class="flex flex-col items-center justify-center py-20 gap-3">
      <div style="color:var(--text-3);font-size:12px;">No won leads yet</div>
      <div style="color:var(--text-4);font-size:10px;">Close deals in Pipeline to see them here</div>
    </div>
    <% } %>

    <% wonLeads.forEach(l => { %>
    <div style="padding:14px 20px;border-bottom:1px solid var(--border-2);">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <div>
          <div style="font-size:13px;font-weight:600;color:var(--text)"><%= l.name %></div>
          <% if (l.company) { %><div style="font-size:11px;color:var(--text-3);margin-top:2px"><%= l.company %></div><% } %>
          <% if (l.email) { %><div style="font-size:10px;color:var(--text-4);margin-top:2px"><%= l.email %></div><% } %>
        </div>
        <div style="text-align:right;flex-shrink:0;margin-left:8px;">
          <div class="mono" style="font-size:13px;font-weight:700;color:var(--green)">
            KES <%= (l.value||0).toLocaleString('en-KE',{minimumFractionDigits:2,maximumFractionDigits:2}) %>
          </div>
          <div style="font-size:9px;color:var(--text-3);margin-top:2px;letter-spacing:.08em;">WON</div>
        </div>
      </div>
      <% if (l.notes) { %>
      <div style="margin-top:8px;font-size:11px;color:var(--text-3);font-style:italic;"><%= l.notes %></div>
      <% } %>
    </div>
    <% }) %>
  </div>
</div>

<!-- ── Client Detail Panel (slide-in) ────────────────────────── -->
<div id="detail-panel" style="position:fixed;top:0;right:-420px;width:420px;height:100vh;background:var(--surface);border-left:1px solid var(--border);z-index:200;transition:right 280ms cubic-bezier(.4,0,.2,1);overflow-y:auto;padding:24px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <span style="font-size:11px;letter-spacing:.12em;font-weight:700;color:var(--text-3);">CLIENT DETAIL</span>
    <button onclick="closeDetail()" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:18px;line-height:1;">✕</button>
  </div>
  <div id="detail-content"></div>
</div>
<div id="detail-overlay" onclick="closeDetail()" style="display:none;position:fixed;inset:0;z-index:199;background:rgba(0,0,0,.4);"></div>

<!-- ── Add Client Modal ───────────────────────────────────────── -->
<div class="modal-backdrop" id="modal">
  <div class="modal-box">
    <div class="flex items-center justify-between mb-5">
      <h2 style="font-size:14px;font-weight:700;letter-spacing:.08em;color:var(--text);">ADD CLIENT</h2>
      <button onclick="closeModal()" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:18px;line-height:1;">✕</button>
    </div>
    <form id="cli-form">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
        <div>
          <label class="lbl">NAME *</label>
          <input id="f-name" class="field" placeholder="Full name" required>
        </div>
        <div>
          <label class="lbl">COMPANY</label>
          <input id="f-company" class="field" placeholder="Company Ltd">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
        <div>
          <label class="lbl">EMAIL</label>
          <input id="f-email" type="email" class="field" placeholder="client@email.com">
        </div>
        <div>
          <label class="lbl">PHONE</label>
          <input id="f-phone" class="field" placeholder="+254 7xx xxx xxx">
        </div>
      </div>
      <div style="margin-bottom:12px;">
        <label class="lbl">SOURCE</label>
        <select id="f-source" class="field" style="cursor:pointer;">
          <option value="manual">Manual</option>
          <option value="upwork">Upwork</option>
          <option value="linkedin">LinkedIn</option>
          <option value="referral">Referral</option>
          <option value="direct">Direct</option>
          <option value="contra">Contra</option>
        </select>
      </div>
      <div style="margin-bottom:20px;">
        <label class="lbl">NOTES</label>
        <textarea id="f-notes" class="field" rows="3" placeholder="Any notes about this client..." style="resize:vertical;"></textarea>
      </div>
      <div class="flex gap-3 justify-end">
        <button type="button" onclick="closeModal()" class="btn btn-ghost">Cancel</button>
        <button type="submit" class="btn btn-primary" style="padding:8px 20px;">ADD CLIENT</button>
      </div>
    </form>
  </div>
</div>

<div id="toast"></div>

<script>
function openModal() { document.getElementById('modal').classList.add('open') }
function closeModal() { document.getElementById('modal').classList.remove('open') }
document.getElementById('modal').addEventListener('click', e => {
  if (e.target === document.getElementById('modal')) closeModal()
})

document.getElementById('cli-form').addEventListener('submit', async e => {
  e.preventDefault()
  const btn = e.target.querySelector('[type=submit]')
  btn.disabled = true; btn.textContent = 'ADDING...'
  try {
    const r = await fetch('/clients/clients', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name:    document.getElementById('f-name').value,
        company: document.getElementById('f-company').value,
        email:   document.getElementById('f-email').value,
        phone:   document.getElementById('f-phone').value,
        source:  document.getElementById('f-source').value,
        notes:   document.getElementById('f-notes').value,
      })
    })
    if (!r.ok) throw new Error((await r.json()).error)
    showToast('Client added', 'ok')
    setTimeout(() => location.reload(), 600)
  } catch(err) {
    showToast(err.message, 'err')
    btn.disabled = false; btn.textContent = 'ADD CLIENT'
  }
})

function selectClient(el, c) {
  document.querySelectorAll('.cli-row').forEach(r => r.style.background = '')
  el.style.background = 'rgba(16,185,129,.06)'
  document.getElementById('detail-content').innerHTML = `
    <div style="margin-bottom:20px;">
      <div style="font-size:20px;font-weight:700;color:var(--text);margin-bottom:4px;">${c.name}</div>
      ${c.company ? `<div style="font-size:13px;color:var(--text-3);">${c.company}</div>` : ''}
    </div>
    <div style="display:grid;gap:12px;margin-bottom:20px;">
      ${c.email ? `<div><div style="font-size:9px;letter-spacing:.1em;color:var(--text-4);margin-bottom:3px;">EMAIL</div><div style="font-size:13px;color:var(--text-2);">${c.email}</div></div>` : ''}
      ${c.phone ? `<div><div style="font-size:9px;letter-spacing:.1em;color:var(--text-4);margin-bottom:3px;">PHONE</div><div style="font-size:13px;color:var(--text-2);">${c.phone}</div></div>` : ''}
      <div><div style="font-size:9px;letter-spacing:.1em;color:var(--text-4);margin-bottom:3px;">SOURCE</div><div style="font-size:12px;color:var(--text-2);">${(c.source||'manual').toUpperCase()}</div></div>
      <div><div style="font-size:9px;letter-spacing:.1em;color:var(--text-4);margin-bottom:3px;">ADDED</div><div class="mono" style="font-size:11px;color:var(--text-3);">${new Date(c.createdAt).toLocaleDateString('en-KE',{day:'2-digit',month:'short',year:'numeric'})}</div></div>
    </div>
    ${c.notes ? `<div style="background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r);padding:12px;margin-bottom:20px;font-size:12px;color:var(--text-2);line-height:1.6;">${c.notes}</div>` : ''}
    <div style="display:flex;gap:8px;">
      <button onclick="deleteClient('${c.id}')" class="btn btn-ghost" style="font-size:11px;color:var(--red);border-color:rgba(239,68,68,.3);">DELETE</button>
    </div>
  `
  document.getElementById('detail-panel').style.right = '0'
  document.getElementById('detail-overlay').style.display = 'block'
}

function closeDetail() {
  document.getElementById('detail-panel').style.right = '-420px'
  document.getElementById('detail-overlay').style.display = 'none'
  document.querySelectorAll('.cli-row').forEach(r => r.style.background = '')
}

async function deleteClient(id) {
  if (!confirm('Delete this client?')) return
  try {
    const r = await fetch(`/clients/clients/${id}`, { method: 'DELETE' })
    if (!r.ok) throw new Error((await r.json()).error)
    showToast('Client deleted', 'ok')
    closeDetail()
    setTimeout(() => location.reload(), 500)
  } catch(err) { showToast(err.message, 'err') }
}

function showToast(msg, type) {
  const t = document.getElementById('toast')
  t.textContent = msg
  t.className = `show t-${type}`
  setTimeout(() => t.className = '', 2800)
}
</script>
