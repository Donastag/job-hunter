<%- include('partials/head', { title }) %>
<%- include('partials/nav', { active }) %>

<div class="px-6 py-5 max-w-6xl mx-auto">

  <!-- Stats bar -->
  <div class="grid grid-cols-6 gap-3 mb-6">
    <% const kstats = [
      { label:'TOTAL',    val: stats.total,    color:'text' },
      { label:'PROPOSAL', val: stats.proposal, color:'green' },
      { label:'PLATFORM', val: stats.platform, color:'blue' },
      { label:'TECH',     val: stats.tech,     color:'purple' },
      { label:'CLIENT',   val: stats.client,   color:'amber' },
      { label:'GENERAL',  val: stats.general,  color:'text-3' },
    ] %>
    <% kstats.forEach(s => { %>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:14px 16px;">
      <div class="mono text-2xl font-bold" style="color:var(--<%= s.color %>);"><%= s.val %></div>
      <div style="font-size:9px;font-weight:700;letter-spacing:.12em;color:var(--text-3);margin-top:3px;"><%= s.label %></div>
    </div>
    <% }) %>
  </div>

  <!-- Toolbar -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex gap-1">
      <% ['all','proposal','platform','tech','client','general'].forEach(f => { %>
      <a href="/knowledge?cat=<%= f %>"
         class="ftab <%= activeFilter === f ? 'on' : '' %>"><%= f.toUpperCase() %></a>
      <% }) %>
    </div>
    <button class="btn btn-primary" onclick="openAdd()">+ ADD ENTRY</button>
  </div>

  <!-- Entries -->
  <% if (entries.length === 0) { %>
  <div style="text-align:center;padding:64px 0;color:var(--text-3);">
    <div style="font-size:32px;margin-bottom:12px;">📚</div>
    <div style="font-size:13px;">No entries yet. Add your first learning.</div>
  </div>
  <% } else { %>
  <div class="flex flex-col gap-2">
    <% entries.forEach(e => { %>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:16px 20px;transition:background 120ms;"
         onmouseenter="this.style.background='var(--surface-2)'" onmouseleave="this.style.background='var(--surface)'">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <% const catColor = {proposal:'green',platform:'blue',tech:'purple',client:'amber',general:'text-3'}[e.category]||'text-3' %>
            <span class="pill" style="color:var(--<%=catColor%>);border-color:rgba(var(--<%=catColor%>-rgb,148,163,184),.4);background:rgba(var(--<%=catColor%>-rgb,148,163,184),.1);">
              <%= e.category.toUpperCase() %>
            </span>
            <% if (e.source) { %>
            <span style="font-size:10px;color:var(--text-3);">via <%= e.source %></span>
            <% } %>
            <span style="font-size:10px;color:var(--text-3);margin-left:auto;">
              <%= new Date(e.createdAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %>
            </span>
          </div>
          <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:6px;"><%= e.title %></div>
          <div style="font-size:13px;color:var(--text-2);line-height:1.6;white-space:pre-wrap;"><%= e.content %></div>
          <% if (e.tags) { %>
          <div class="flex flex-wrap gap-1 mt-3">
            <% e.tags.split(',').map(t=>t.trim()).filter(Boolean).forEach(tag => { %>
            <span class="skill-tag">#<%= tag %></span>
            <% }) %>
          </div>
          <% } %>
        </div>
        <div class="flex gap-1 flex-shrink-0">
          <button class="btn btn-ghost" style="padding:4px 10px;font-size:10px;"
            onclick="openEdit(<%- JSON.stringify(e) %>)">EDIT</button>
          <button class="btn btn-ghost" style="padding:4px 10px;font-size:10px;color:var(--red);"
            onclick="deleteEntry('<%= e.id %>')">DEL</button>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Add / Edit Modal -->
<div id="modal" class="modal-backdrop">
  <div class="modal-box" style="width:520px;">
    <div class="flex items-center justify-between mb-5">
      <h2 id="modal-title" style="font-size:13px;font-weight:700;letter-spacing:.1em;color:var(--text);">ADD ENTRY</h2>
      <button onclick="closeModal()" style="color:var(--text-3);font-size:18px;cursor:pointer;line-height:1;">×</button>
    </div>
    <form id="entry-form" class="flex flex-col gap-3">
      <input type="hidden" id="entry-id">
      <div>
        <label class="lbl">TITLE *</label>
        <input class="field" id="f-title" placeholder="What did you learn?" required>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="lbl">CATEGORY</label>
          <select class="field" id="f-category">
            <option value="general">General</option>
            <option value="proposal">Proposal</option>
            <option value="platform">Platform</option>
            <option value="tech">Tech</option>
            <option value="client">Client</option>
          </select>
        </div>
        <div>
          <label class="lbl">SOURCE</label>
          <input class="field" id="f-source" placeholder="e.g. won bid, Upwork, client">
        </div>
      </div>
      <div>
        <label class="lbl">CONTENT *</label>
        <textarea class="field" id="f-content" rows="5" placeholder="The actual learning or note..." required style="resize:vertical;"></textarea>
      </div>
      <div>
        <label class="lbl">TAGS (comma-separated)</label>
        <input class="field" id="f-tags" placeholder="e.g. automation, python, upwork">
      </div>
      <div class="flex gap-2 pt-1">
        <button type="submit" id="save-btn" class="btn btn-primary flex-1">SAVE</button>
        <button type="button" onclick="closeModal()" class="btn btn-ghost">CANCEL</button>
      </div>
    </form>
  </div>
</div>

<div id="toast"></div>

<script>
let editMode = false

function toast(msg, ok=true) {
  const t = document.getElementById('toast')
  t.textContent = msg
  t.className = 'show ' + (ok ? 't-ok' : 't-err')
  setTimeout(() => t.className = '', 2800)
}

function openAdd() {
  editMode = false
  document.getElementById('modal-title').textContent = 'ADD ENTRY'
  document.getElementById('save-btn').textContent = 'SAVE'
  document.getElementById('entry-id').value = ''
  document.getElementById('entry-form').reset()
  document.getElementById('modal').classList.add('open')
  document.getElementById('f-title').focus()
}

function openEdit(e) {
  editMode = true
  document.getElementById('modal-title').textContent = 'EDIT ENTRY'
  document.getElementById('save-btn').textContent = 'UPDATE'
  document.getElementById('entry-id').value = e.id
  document.getElementById('f-title').value = e.title
  document.getElementById('f-category').value = e.category
  document.getElementById('f-source').value = e.source || ''
  document.getElementById('f-content').value = e.content
  document.getElementById('f-tags').value = e.tags || ''
  document.getElementById('modal').classList.add('open')
}

function closeModal() {
  document.getElementById('modal').classList.remove('open')
}

document.getElementById('entry-form').addEventListener('submit', async e => {
  e.preventDefault()
  const id = document.getElementById('entry-id').value
  const body = {
    title:    document.getElementById('f-title').value,
    category: document.getElementById('f-category').value,
    source:   document.getElementById('f-source').value,
    content:  document.getElementById('f-content').value,
    tags:     document.getElementById('f-tags').value,
  }
  const btn = document.getElementById('save-btn')
  btn.disabled = true; btn.textContent = '...'

  const url    = editMode ? `/knowledge/${id}` : '/knowledge'
  const method = editMode ? 'PUT' : 'POST'

  const r = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) })
  const d = await r.json()
  btn.disabled = false

  if (d.ok) { toast(editMode ? 'Updated' : 'Entry saved'); closeModal(); location.reload() }
  else       { toast(d.error || 'Error', false); btn.textContent = editMode ? 'UPDATE' : 'SAVE' }
})

async function deleteEntry(id) {
  if (!confirm('Delete this entry?')) return
  const r = await fetch(`/knowledge/${id}`, { method: 'DELETE' })
  const d = await r.json()
  if (d.ok) { toast('Deleted'); document.querySelector(`[onclick*="${id}"]`)?.closest('[style]')?.remove() }
  else toast(d.error || 'Error', false)
}

document.getElementById('modal').addEventListener('click', e => {
  if (e.target === document.getElementById('modal')) closeModal()
})
</script>

</body></html>
