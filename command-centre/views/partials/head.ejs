<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Nexara CC</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* ── Design Tokens ─────────────────────────────────── */
    :root {
      --bg:          #090B0F;
      --surface:     #0D1117;
      --surface-2:   #111827;
      --surface-3:   #1A2332;
      --border:      #1E2D3D;
      --border-2:    #0F1923;
      --text:        #F1F5F9;
      --text-2:      #94A3B8;
      --text-3:      #4B5563;
      --text-4:      #2D3748;
      --green:       #10B981;
      --green-dim:   rgba(16,185,129,.12);
      --green-ring:  rgba(16,185,129,.4);
      --blue:        #3B82F6;
      --blue-dim:    rgba(59,130,246,.12);
      --blue-ring:   rgba(59,130,246,.4);
      --amber:       #F59E0B;
      --amber-dim:   rgba(245,158,11,.12);
      --amber-ring:  rgba(245,158,11,.4);
      --red:         #EF4444;
      --red-dim:     rgba(239,68,68,.12);
      --purple:      #8B5CF6;
      --purple-dim:  rgba(139,92,246,.12);
      --purple-ring: rgba(139,92,246,.4);
      --orange:      #F97316;
      --r-sm: 4px; --r: 6px; --r-lg: 8px; --r-xl: 12px;
    }

    /* ── Reset & Base ───────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg); color: var(--text); min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    .mono { font-family: 'JetBrains Mono', 'Fira Code', monospace; }

    /* ── Scrollbars ─────────────────────────────────────── */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: var(--border-2); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--surface-3); }

    /* ── Live dot ───────────────────────────────────────── */
    .live-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--green);
      animation: livePulse 2.5s ease-in-out infinite;
    }
    @keyframes livePulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(16,185,129,.5); }
      60%     { box-shadow: 0 0 0 6px rgba(16,185,129,0); }
    }

    /* ── Score badges (circular) ────────────────────────── */
    .score-badge {
      width: 48px; height: 48px; border-radius: 50%;
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; border: 2px solid;
      flex-shrink: 0; position: relative;
      transition: transform 150ms ease-out, box-shadow 150ms ease-out;
    }
    .score-badge:hover { transform: scale(1.1); }
    .score-num { font-family: 'JetBrains Mono', monospace; font-size: 15px; font-weight: 700; line-height: 1; }
    .score-lbl { font-size: 7px; letter-spacing: .1em; margin-top: 1px; opacity: .55; }
    .sh { color: var(--green);  border-color: var(--green-ring);  background: var(--green-dim);  box-shadow: 0 0 14px rgba(16,185,129,.18); }
    .sm { color: var(--blue);   border-color: var(--blue-ring);   background: var(--blue-dim);   box-shadow: 0 0 14px rgba(59,130,246,.14); }
    .so { color: var(--text-2); border-color: var(--border);      background: rgba(148,163,184,.06); }
    .sl { color: var(--text-3); border-color: var(--border-2);    background: transparent; }

    /* ── Tier + status pills ────────────────────────────── */
    .pill {
      display: inline-flex; align-items: center; height: 18px;
      padding: 0 7px; border-radius: var(--r-sm); border: 1px solid;
      font-size: 9px; font-weight: 700; letter-spacing: .12em; white-space: nowrap;
    }
    .pill-priority { color: var(--green);  border-color: var(--green-ring);  background: var(--green-dim); }
    .pill-alert    { color: var(--blue);   border-color: var(--blue-ring);   background: var(--blue-dim);  }
    .pill-loom     { color: var(--amber);  border-color: var(--amber-ring);  background: var(--amber-dim); }
    .pill-new      { color: var(--text-3); border-color: var(--border);      background: rgba(100,116,139,.08); }
    .pill-draft    { color: var(--purple); border-color: var(--purple-ring); background: var(--purple-dim); }
    .pill-applied  { color: var(--blue);   border-color: var(--blue-ring);   background: var(--blue-dim);  }
    .pill-archived { color: var(--text-4); border-color: var(--border-2);    background: transparent; }

    /* ── Table job rows ─────────────────────────────────── */
    .job-row {
      border-left: 3px solid transparent;
      transition: background 120ms ease;
      cursor: pointer;
    }
    .job-row:hover { background: rgba(30,41,59,.22); }
    .job-row.tier-p { border-left-color: rgba(16,185,129,.55); }
    .job-row.tier-a { border-left-color: rgba(59,130,246,.45); }

    /* ── Skill tags ─────────────────────────────────────── */
    .skill-tag {
      display: inline-block; padding: 1px 7px; border-radius: 3px;
      font-size: 10px; color: var(--text-3);
      background: rgba(30,41,59,.7); border: 1px solid var(--border);
    }
    .platform-tag {
      display: inline-block; padding: 1px 7px; border-radius: 3px;
      font-size: 9px; font-weight: 600; letter-spacing: .08em;
      color: var(--text-3); background: rgba(30,41,59,.5); border: 1px solid var(--border);
      text-transform: uppercase;
    }

    /* ── Competition coloring on proposals ──────────────── */
    .props-low  { color: var(--green); }
    .props-mid  { color: var(--amber); }
    .props-high { color: var(--red);   }

    /* ── Time freshness ─────────────────────────────────── */
    .time-hot    { color: var(--green); }
    .time-warm   { color: var(--amber); }
    .time-cold   { color: var(--text-3); }

    /* ── Buttons ────────────────────────────────────────── */
    .btn {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 5px 12px; border-radius: var(--r);
      font-size: 11px; font-weight: 600; letter-spacing: .07em;
      border: 1px solid; cursor: pointer;
      transition: all 150ms ease-out; font-family: inherit;
      white-space: nowrap; line-height: 1;
    }
    .btn-primary { color: var(--green); border-color: var(--green-ring); background: var(--green-dim); }
    .btn-primary:hover { background: rgba(16,185,129,.22); box-shadow: 0 0 16px rgba(16,185,129,.15); }
    .btn-primary:disabled { opacity: .45; cursor: not-allowed; }
    .btn-ghost { color: var(--text-3); border-color: var(--border); background: transparent; }
    .btn-ghost:hover { color: var(--text-2); border-color: var(--surface-3); background: rgba(30,41,59,.3); }

    /* ── Filter tabs ────────────────────────────────────── */
    .ftab {
      padding: 5px 14px; border-radius: var(--r);
      font-size: 11px; font-weight: 600; letter-spacing: .07em;
      text-decoration: none; border: 1px solid transparent;
      transition: all 150ms ease-out; color: var(--text-3);
    }
    .ftab:hover { color: var(--text-2); border-color: var(--border); }
    .ftab.on { color: var(--green); border-color: var(--green-ring); background: var(--green-dim); }

    /* ── Form fields ────────────────────────────────────── */
    .field {
      width: 100%; padding: 8px 12px; border-radius: var(--r);
      background: rgba(17,24,39,.8); border: 1px solid var(--border);
      color: var(--text); font-size: 13px; font-family: inherit;
      outline: none; transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .field:focus { border-color: var(--green-ring); box-shadow: 0 0 0 3px rgba(16,185,129,.07); }
    .field::placeholder { color: var(--text-3); }
    label.lbl {
      display: block; font-size: 10px; font-weight: 600;
      letter-spacing: .1em; color: var(--text-3); margin-bottom: 6px;
    }

    /* ── Toast ──────────────────────────────────────────── */
    #toast {
      position: fixed; bottom: 24px; right: 24px; z-index: 9999;
      padding: 10px 16px; border-radius: var(--r-lg);
      background: var(--surface); border: 1px solid var(--border);
      color: var(--text-2); font-size: 13px; font-weight: 500;
      min-width: 200px; max-width: 320px;
      opacity: 0; pointer-events: none;
      transform: translateY(8px);
      transition: opacity 280ms ease, transform 280ms ease;
      box-shadow: 0 8px 32px rgba(0,0,0,.45);
    }
    #toast.show { opacity: 1; pointer-events: auto; transform: translateY(0); }
    #toast.t-ok  { border-color: var(--green-ring); color: var(--green); }
    #toast.t-err { border-color: rgba(239,68,68,.4); color: var(--red); }

    /* ── Kanban columns ─────────────────────────────────── */
    .kol-header {
      padding: 10px 14px; border-radius: var(--r-lg) var(--r-lg) 0 0;
      border: 1px solid; border-bottom: none;
    }
    .lead-card {
      border-radius: var(--r-lg); padding: 12px 14px;
      background: var(--surface); border: 1px solid var(--border);
      border-left: 3px solid;
      transition: transform 150ms ease-out, box-shadow 150ms ease-out;
    }
    .lead-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.3); }

    /* ── Modal ──────────────────────────────────────────── */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 100;
      background: rgba(0,0,0,.72); backdrop-filter: blur(6px);
      display: none; align-items: center; justify-content: center;
      animation: fadeIn 200ms ease;
    }
    .modal-backdrop.open { display: flex; }
    .modal-box {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--r-xl); padding: 28px; width: 420px;
      box-shadow: 0 24px 64px rgba(0,0,0,.55);
      animation: scaleIn 200ms cubic-bezier(.34,1.56,.64,1);
    }
    @keyframes fadeIn  { from { opacity: 0; } to { opacity: 1; } }
    @keyframes scaleIn { from { opacity: 0; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }

    /* ── Expanded job detail ────────────────────────────── */
    .job-detail-inner {
      max-height: 0; overflow: hidden; padding: 0 20px;
      transition: max-height 240ms ease, padding 240ms ease;
    }
    .job-detail-inner.open {
      max-height: 220px; padding: 16px 20px;
    }
  </style>
</head>
<body>
