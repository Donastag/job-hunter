generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  leads         Lead[]
  templates     Template[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id             String    @id @default(cuid())
  platform       String
  externalId     String?
  title          String
  description    String?
  budget         String?
  type           String?
  skills         String
  clientName     String?
  clientRating   Float?
  clientSpent    String?
  clientHired    Int?
  clientVerified Boolean   @default(false)
  proposals      Int       @default(0)
  score          Int       @default(0)
  tier           String    @default("normal")
  status         String    @default("new")
  postedAt       DateTime?
  url            String?
  fetchedAt      DateTime  @default(now())
  brief          String?
  loom           Boolean   @default(false)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  company   String?
  source    String
  value     Float    @default(0)
  stage     String   @default("contacted")
  age       Int      @default(0)
  notes     String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  name      String
  category  String
  content   String
  variables String
  wins      Int      @default(0)
  sent      Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Analytics {
  id        String   @id @default(cuid())
  date      DateTime @unique
  proposals Int      @default(0)
  responses Int      @default(0)
  wins      Int      @default(0)
  revenue   Float    @default(0)
  jobsSeen  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id        String   @id @default(cuid())
  type      String
  message   String
  time      String
  read      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
}

model Invoice {
  id          String   @id @default(cuid())
  clientName  String
  clientEmail String?
  description String?
  amount      Float    @default(0)
  status      String   @default("draft")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("invoices")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  company   String?
  phone     String?
  source    String   @default("manual")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("general")
  tags      String   @default("")
  content   String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_entries")
}

model PortfolioItem {
  id          String    @id @default(cuid())
  title       String
  client      String?
  techStack   String    @default("")
  outcome     String?
  revenue     Float     @default(0)
  testimonial String?
  url         String?
  status      String    @default("active")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("portfolio_items")
}
