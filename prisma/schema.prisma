// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  leads         Lead[]
  templates     Template[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id              String   @id @default(cuid())
  platform        String   // upwork, linkedin, contra, toptal, manual
  externalId     String?
  title           String
  description     String?
  budget          String?
  type            String?  // fixed, hourly
  skills          String   // JSON string array
  clientName      String?
  clientRating    Float?
  clientSpent     String?
  clientHired    Int?
  clientVerified Boolean  @default(false)
  proposals      Int      @default(0)
  score          Int      @default(0)
  tier           String   @default("normal") // priority, alert, normal
  status         String   @default("new") // new, draft, applied, archived
  postedAt       DateTime?
  fetchedAt      DateTime @default(now())
  brief          String?  // AI-generated brief
  loom           Boolean  @default(false)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  company   String?
  source    String   // upwork, linkedin, contra, toptal, direct, manual
  value     Float    @default(0)
  stage     String   @default("contacted") // contacted, engaged, call_booked, negotiating, won
  age       Int      @default(0) // days in current stage
  notes     String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id         String   @id @default(cuid())
  name       String
  category   String
  content    String
  variables  String   // JSON string array
  wins       Int      @default(0)
  sent       Int      @default(0)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Analytics {
  id        String   @id @default(cuid())
  date      DateTime @unique
  proposals Int      @default(0)
  responses Int      @default(0)
  wins      Int      @default(0)
  revenue   Float    @default(0)
  jobsSeen  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id        String   @id @default(cuid())
  type      String   // priority, alert, signal, win
  message   String
  time      String   // "4m", "2h", etc.
  read      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
}
